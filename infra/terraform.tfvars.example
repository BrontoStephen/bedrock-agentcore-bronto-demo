# Copy to terraform.tfvars (gitignored) and fill in your values.

runtime_arn = "arn:aws:bedrock-agentcore:eu-west-1:<account-id>:runtime/agentcore_bronto_demo-XXXXXXXX"

# Passed to the weekly patch CodeBuild so redeploy.sh can re-deploy with the right config:
agentcore_memory_id            = "agentcore_bronto_demo-XXXXXXXX"
agentcore_semantic_strategy_id = "triage_semantic-XXXXXXXX"
gateway_secret_arn             = "arn:aws:secretsmanager:eu-west-1:<account-id>:secret:agentcore-bronto-demo/gateway-client-XXXXXX"
# ALB endpoint of the collector service (terraform output collector_otlp_endpoint,
# available only after the first apply - re-plan/apply once to pick it up):
collector_otlp_endpoint = "http://<collector-alb-dns-name>"

# --- Collector service (Bronto credentials) ---
# First account (required):
bronto_api_key = "replace-with-your-first-bronto-ingestion-key"
# bronto_otlp_base defaults to https://ingestion.eu.bronto.io - override for US: https://ingestion.us.bronto.io

# Second account (optional broadcast target - leave blank until provisioned):
# bronto_otlp_base_2 = "https://ingestion.eu.bronto.io"
# bronto_api_key_2   = "replace-with-your-second-bronto-ingestion-key"
