# Copy to .env and fill in. Do NOT commit .env.

# --- Bronto ingestion ---
# EU region endpoints base (use https://ingestion.us.bronto.io for US).
# Data lands in the `agentcore-bronto-demo` dataset (routed by service.name).
BRONTO_OTLP_BASE=https://ingestion.eu.bronto.io
BRONTO_API_KEY=replace-with-your-bronto-ingestion-key

# --- AWS / Bedrock ---
AWS_REGION=eu-west-1
# Agentic tool-calling uses the stronger Nova Pro (Anthropic is gated on this account).
BEDROCK_MODEL_ID=eu.amazon.nova-pro-v1:0

# --- AgentCore Memory (optional) ---
# Provision with: python agent/provision_memory.py  (prints these two ids)
AGENTCORE_MEMORY_ID=
AGENTCORE_SEMANTIC_STRATEGY_ID=
AGENT_ACTOR_ID=telemetry-triage
