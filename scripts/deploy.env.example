# Copy to scripts/deploy.env (gitignored) and fill in your account-specific values.
# Consumed by scripts/redeploy.sh (and the weekly CodeBuild patch job reads the
# same names as environment variables).

# Required:
BRONTO_API_KEY_SECRET_ARN=arn:aws:secretsmanager:<region>:<account-id>:secret:bedrock-bronto-demo/bronto-api-key-XXXXXX
AGENTCORE_MEMORY_ID=agentcore_bronto_demo-XXXXXXXX          # printed by agent/provision_memory.py

# Optional (agent runs without them):
AGENTCORE_SEMANTIC_STRATEGY_ID=triage_semantic-XXXXXXXX     # printed by agent/provision_memory.py
GATEWAY_SECRET_ARN=arn:aws:secretsmanager:<region>:<account-id>:secret:agentcore-bronto-demo/gateway-client-XXXXXX  # printed by gateway/provision_gateway.py

# Optional overrides:
# AWS_REGION=eu-west-1
# BEDROCK_MODEL_ID=eu.amazon.nova-pro-v1:0
# BRONTO_OTLP_BASE=https://ingestion.eu.bronto.io
